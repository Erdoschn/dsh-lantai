{
  "name": "dsh-lantai",
  "version": "0.2.0",
  "description": "兰台·簿 (lantai) — a ledger for what your agent learned: health-check a skill library for contradictions, islands and rot, gate what gets written, and archive instead of deleting.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "skills",
    "agent-memory",
    "audit",
    "knowledge-graph",
    "lint"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node --test",
    "check": "node --check lib/index.js && node --check lib/tools.js && node --check lib/rules.js && node --check lib/schema.js && node --check lib/skill.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Erdoschn/dsh-lantai.git"
  },
  "bugs": {
    "url": "https://github.com/Erdoschn/dsh-lantai/issues"
  },
  "homepage": "https://github.com/Erdoschn/dsh-lantai#readme",
  "author": "Erdoschn"
}
